# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in what you need.
#  Everything here is optional — the site runs without any of it.
# ─────────────────────────────────────────────────────────────

# The public address of the invitation. Used for share previews
# (WhatsApp / iMessage / Instagram) and search metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Flip the whole site between its two lives without editing code:
#   invitation  → sealed envelope, event details, RSVP form
#   keepsake    → same design, RSVP replaced by the photo gallery
# Leave unset to use the `phase` value in content/wedding.ts.
# NEXT_PUBLIC_PHASE=invitation

# Where RSVP submissions are delivered. Any endpoint that accepts a
# JSON POST works: Google Apps Script, Zapier, Make, Formspree, n8n.
# If this is not set, RSVPs are logged to the server console only.
RSVP_WEBHOOK_URL=

# Optional: also email each RSVP as it arrives, via Resend (resend.com).
# All three must be set for email delivery to switch on.
RSVP_RESEND_API_KEY=
RSVP_EMAIL_FROM=
RSVP_EMAIL_TO=
